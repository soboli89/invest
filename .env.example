# Generate a random secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Used to create the first administrator when the database has no admin yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true when served over HTTPS.
NODE_ENV=development
PORT=3000

# Optional: defaults to data/portfolio.db
# DATABASE_PATH=data/portfolio.db

# Gmail SMTP notifications for project creation and updates.
# Create a Google App Password (do not use your regular Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public URL used in notification emails.
PORTFOLIO_URL=http://localhost:3000
